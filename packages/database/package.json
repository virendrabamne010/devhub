{
  "name": "@devhub/database",
  "version": "2.0.0",
  "description": "DevHub - Complete DevOps Management Platform Database Layer",
  "private": true,
  "main": "index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./index.ts",
      "require": "./index.ts"
    }
  },
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:reset": "prisma migrate reset --force",
    "seed": "tsx prisma/seed.ts",
    "studio": "prisma studio",
    "build": "tsc",
    "dev": "tsx index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.11.0",
    "bcryptjs": "^2.4.3",
    "eslint": "^8.56.0",
    "prettier": "^3.2.4",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "5.3.3"
  }
}
