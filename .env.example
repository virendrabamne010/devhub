# ============================================================
# DevHub - Environment Configuration
# Copy this file to .env and adjust values for your environment
# ============================================================

# --- Server ---
NODE_ENV=development
PORT=3001
# Comma-separated list of allowed CORS origins
CORS_ORIGIN=http://localhost:5173

# --- Database ---
DATABASE_URL="postgresql://devhub:devhub_password@localhost:5432/devhub?schema=public"

# --- JWT / Authentication ---
# !! IMPORTANT: You MUST set a strong random secret before deploying !!
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# The server will refuse to start in production if this is weak or unchanged.
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# --- Rate Limiting ---
# 100 requests per 15 minutes (global), login is stricter (see config.ts)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=10000

# --- Prisma (optional override) ---
PRISMA_CLIENT_ENGINE_TYPE=library
